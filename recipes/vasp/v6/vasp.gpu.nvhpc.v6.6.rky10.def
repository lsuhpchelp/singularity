Bootstrap: docker
From: intel/oneapi-toolkit:2026.0.1-devel-rockylinux10

%labels
Author fchen14@lsu.edu

%files

src/v6.6/vasp.6.6.0.tgz                  /opt/

%post

#for f in /etc/yum.repos.d/*intel*repo /etc/yum.repos.d/*oneAPI*repo /etc/yum.repos.d/*oneapi*repo; do
#    [ -f "$f" ] && sed -i 's/enabled=1/enabled=0/g' "$f"
#done

dnf install -y perl-ExtUtils-ParseXS perl-ExtUtils-MakeMaker
dnf install -y perl-devel
#dnf install -y epel-release
#dnf config-manager --set-enabled crb  # Formerly "PowerTools" in EL9
# for pmi2 support, we need hwloc slurm slurm-devel
dnf install -y wget hwloc #slurm slurm-devel
# environment-modules to work with oneapi-hpckit
dnf install -y environment-modules
dnf install -y rsync

# compile and install slurm
#cd /opt
#wget https://github.com/SchedMD/slurm/archive/refs/tags/slurm-22-05-8-1.tar.gz
#tar zxf slurm-22-05-8-1.tar.gz
#cd slurm-slurm-22-05-8-1
#./configure --prefix=/usr --libdir=/usr/lib64 && make -j20 && make install
#cd contribs && make -j20 && make install

# https://thelinuxcluster.com/2022/05/14/installing-environment-modules-on-rocky-linux-8-5/
# need to source the line or module command wont be available
source /etc/profile.d/modules.sh

dnf install -y 'dnf-command(config-manager)'
#dnf config-manager --add-repo https://developer.download.nvidia.com/hpc-sdk/rhel/nvhpc.repo
#dnf install -y nvhpc-cuda-multi-26.3
dnf config-manager --add-repo https://developer.download.nvidia.com/hpc-sdk/rhel/nvhpc.repo
dnf install -y nvhpc-26-3-cuda-multi

#module load /opt/nvidia/hpc_sdk/modulefiles/nvhpc/26.3
module load /opt/nvidia/hpc_sdk/modulefiles/nvhpc-hpcx-cuda13/26.3

#module load /opt/nvidia/hpc_sdk/modulefiles/nvhpc-openmpi4/26.3

cd /opt
tar zxf vasp.6.6.0.tgz
cd vasp.6.6.0
cp arch/makefile.include.nvhpc_ompi_mkl_omp_acc ./makefile.include
sed -i '22c\GPU        ?= -gpu=cc80,cc89,cuda13.1' makefile.include
#sed -i '22 s/^/#/' makefile.include
#sed -i '28 s/^#//' makefile.include
/opt/intel/oneapi/modulefiles-setup.sh --output-dir=/opt/intel/oneapi/modulefiles
export MODULEPATH=/opt/intel/oneapi/modulefiles:$MODULEPATH
module load compiler
module load mkl

# build vasp
make veryclean
make DEPS=1 -j16
#make test

%environment
export LC_ALL=C
source /etc/profile.d/modules.sh
export MODULEPATH=/opt/nvidia/hpc_sdk/modulefiles/:$MODULEPATH
export MODULEPATH=/opt/intel/oneapi/modulefiles:$MODULEPATH
#module load nvhpc-openmpi4/26.3
module load nvhpc-hpcx-cuda13/26.3
module load compiler
module load mkl
export PATH=/opt/vasp.6.6.0/bin:$PATH
export LD_LIBRARY_PATH=/usr/lib/:$LD_LIBRARY_PATH

%runscript
exec "$@"

