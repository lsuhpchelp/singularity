Bootstrap: docker
From: intel/oneapi-toolkit:2026.0.1-devel-rockylinux10

%labels
Author fchen14@lsu.edu

%files

src/v6.6/vasp.6.6.0.tgz                  /opt/

%post

dnf install -y perl-ExtUtils-MakeMaker
dnf install -y wget hwloc 
dnf install -y environment-modules
dnf install -y rsync
dnf install -y autoconf automake libtool m4
# https://thelinuxcluster.com/2022/05/14/installing-environment-modules-on-rocky-linux-8-5/

# compile and install slurm
cd /opt
wget https://github.com/SchedMD/slurm/archive/refs/tags/slurm-22-05-8-1.tar.gz
tar zxf slurm-22-05-8-1.tar.gz  
cd slurm-slurm-22-05-8-1
./configure --prefix=/usr --libdir=/usr/lib64 && make -j20 && make install
cd contribs && make -j20 && make install

# need to source the line or module command wont be available
source /etc/profile.d/modules.sh
/opt/intel/oneapi/modulefiles-setup.sh --output-dir=/opt/intel/oneapi/modulefiles
export MODULEPATH=/opt/intel/oneapi/modulefiles:$MODULEPATH
module load compiler mpi mkl

# install HDF5
mkdir /opt/packages
cd /opt/packages
wget https://github.com/HDFGroup/hdf5/releases/download/hdf5_1.14.4.3/hdf5-1.14.4-3.tar.gz
tar -xf hdf5-1.14.4-3.tar.gz && rm hdf5-1.14.4-3.tar.gz
cd hdf5-1.14.4-3
CC=icx CXX=icpx FC=ifx ./configure --prefix=/usr/ --with-zlib=/usr --enable-fortran
make -j`nproc` && make install

# install LIBXC
cd /opt/packages
LIBXC_VERSION=7.0.0
wget https://gitlab.com/libxc/libxc/-/archive/${LIBXC_VERSION}/libxc-${LIBXC_VERSION}.tar.gz
tar -xf libxc-${LIBXC_VERSION}.tar.gz && rm libxc-${LIBXC_VERSION}.tar.gz
cd libxc-${LIBXC_VERSION}

autoreconf -i

CC=icx FC=ifx ./configure \
  --prefix=/opt/libxc/${LIBXC_VERSION} \
  --enable-shared \
  --enable-static \
  --disable-fhc

make -j`nproc`
make install

cd /opt
tar zxf vasp.6.6.0.tgz
cd vasp.6.6.0

#git clone -b 6.6.x git@github.com:vasp-dev/cmake.git cmake
git clone https://github.com/vasp-dev/cmake.git cmake

bash cmake/setup.sh
mkdir -p build
cd build

# Configure (example): point CMake to the VASP source root and pass options
cmake .. \
  -DLibXC_ROOT="/opt/libxc/${LIBXC_VERSION}" \
  -DVASP_OPENMP=ON \
  -DVASP_HDF5=ON \
  -DVASP_SCALAPACK=ON \
  -DVASP_LIBXC=ON

#  -DVASP_LIBBEEF=ON \
#  -DVASP_DFTD4=ON #\
#  -DVASP_WANNIER90=ON

# Optional: use Ninja instead of Make
# cmake /your/vasp/directory -G Ninja -DVASP_OPENMP=ON
make -j all

%environment
export LC_ALL=C
source /etc/profile.d/modules.sh
export MODULEPATH=/opt/intel/oneapi/modulefiles:$MODULEPATH
module load compiler mpi mkl
export PATH=/opt/vasp.6.6.0/bin:$PATH
export LD_LIBRARY_PATH=/usr/lib/:$LD_LIBRARY_PATH

%runscript
exec "$@"

