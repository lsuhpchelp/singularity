apt update && apt install -y wget

cd /opt
wget https://itasca-software.s3.us-east-1.amazonaws.com/itasca-software/9.subscription/itascasoftware.9.8.53.deb
DEBIAN_FRONTEND=noninteractive apt -y install -f ./itascasoftware.9.8.53.deb
rm itascasoftware.9.8.53.deb
